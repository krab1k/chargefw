{
  "version": 6,
  "configurePresets": [
    {
      "name": "_validation",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CHARGEFW_BUILD_TESTS": "ON",
        "CHARGEFW_BUILD_CLI": "ON",
        "CHARGEFW_BUILD_PYTHON": "ON",
        "CHARGEFW_ENABLE_WARNINGS": "ON",
        "CHARGEFW_ENABLE_NATIVE_OPTIMIZATIONS": "OFF",
        "CHARGEFW_PYTHON_EXECUTABLE": "/usr/bin/python3"
      }
    },
    {
      "name": "_gcc-validation",
      "hidden": true,
      "inherits": "_validation",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "_clang-validation",
      "hidden": true,
      "inherits": "_validation",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "_gcc-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "_gcc-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CHARGEFW_ENABLE_NATIVE_OPTIMIZATIONS": "ON"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": "_clang-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "_clang-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CHARGEFW_ENABLE_NATIVE_OPTIMIZATIONS": "ON"
      }
    },
    {
      "name": "clang-asan",
      "displayName": "Clang ASan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CHARGEFW_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "clang-ubsan",
      "displayName": "Clang UBSan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CHARGEFW_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang Tidy",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CHARGEFW_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ]
}
